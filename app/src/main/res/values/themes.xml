<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TripBudget" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Logo-only splash (Android 12+ recommended):
      sky background + centered ic_splash_logo. Fast — no full-screen image decode.
    -->
    <style name="Theme.TripBudget.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.TripBudget</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
